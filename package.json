{
  "name": "magister-monorepo",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.5",
    "hono": "4.13.5",
    "ip-address": "10.7.0",
    "kysely": "0.28.17",
    "shell-quote": "1.10.0",
    "ws": "8.21.3"
  },
  "scripts": {
    "build": "bun run build:mcli && bun run build:mtui && bun run build:mcp",
    "build:release": "bun run build:mcli && bun run build:mtui",
    "build:mcli": "bun run --cwd apps/mcli build",
    "build:mcp": "bun run --cwd apps/mcp build",
    "build:mtui": "bun run --cwd apps/mtui build",
    "dev": "bun run apps/mcli/src/index.ts",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "mcli": "bun run apps/mcli/src/index.ts",
    "mtui": "bun run apps/mtui/src/index.tsx",
    "setup": "bun run apps/mcli/src/index.ts setup",
    "test": "bun test packages/shared apps/mcp/src/lib",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd apps/mcli typecheck && bun run --cwd apps/mtui typecheck && bun run --cwd apps/mcp typecheck",
    "tui": "bun run apps/mtui/src/index.tsx"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "bun-types": "latest",
    "typescript": "^7.0.2"
  }
}
